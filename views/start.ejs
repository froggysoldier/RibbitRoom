 <!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Ribbit Room</title>
  <link rel="stylesheet" href="/style.css?v=<%= version %>">
  <link rel="stylesheet" href="/style2.css?v=<%= version %>">
        <link rel="apple-touch-icon" sizes="180x180" href="images/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="images/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="images/favicon-16x16.png">
        <link rel="manifest" href="images/site.webmanifest">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
<div class="page-wrapper">
<div class="page-content">
<header>
  <button id="loginBtn">Login / Registrieren</button>
  <img src="images/logo.png" alt="Mein Logo" class="logo">
  <nav>
    <ul>
    <li> <a href="/start">Startseite</a></li>
    <li> <a href="/index">Chatroom</a></li>
    <li> <a href="/kontakt">Kontakt</a></li>
    <li> <a href="/impressum">Impressum</a></li>
     </ul>
  </nav>
</header>

<main>
    <div class="center-block">
         <ul class="regeln">
                  <h3><span class="highlight">Chatroom Regeln:</span></h3>
           <li>Sei Respektvoll gegenüber den anderen im Chat.</li>
           <li>Kein Sexismus, Rassismus, Antisemitismus oder andere Hassrede.</li>
           <li>Vermeide Politische, Religiöse oder negative Themen.</li>
           <li>Kein Spamming.</li>
           <li>Keine sexuell unangebrachten oder respektlosen Kommentare.</li>
           <li>Bitte frag nicht nach extra Rechte (Admin).</li>
         </ul>
         </div>

</main>

<!-- Modal für Login/Register -->
<div id="loginModal" class="modal">
  <div class="modal-content">
    <span class="close">×</span>
    <h2>Login</h2>
    <input type="text" id="username" placeholder="Benutzername">
    <input type="password" id="password" placeholder="Passwort">
    <button id="loginSubmit">Einloggen</button>
    <hr>
    <h3>Oder registrieren</h3>
    <input type="text" id="newUser" placeholder="Benutzername">
    <input type="password" id="newPass" placeholder="Passwort">
    <input type="email" id="email" placeholder="E-Mail">
    <button id="registerSubmit">Registrieren</button>
  </div>
</div>

 
<script src="/socket.io/socket.io.js"></script>
<script type="module" src="/js/app.js"></script>

<!-- FISCH CLICKER -->

<div id="slideBox">
  <h2>Fische: <span id="counter">0</span></h2>
  <h2>Fische pro Sekunde: <span id="fpsCounter">0</span></h2>
  <h2>Kundenrabatt: <span id="DiscountCounter">0</span></h2>

  <div class="klickbares">
    <img
      src="images/fischer.png"
      id="fisher"
      alt="Fisher"
      width="250"
      style="cursor: pointer;"
    >

    <br><br>
    <button id="buyUpgrade0">Bessere Angel kaufen (15) - Aktuell: 0</button><br><br>
    <button id="buyUpgrade1">Fischer anstellen (100) - Aktuell: 0</button><br><br>
    <button id="buyUpgrade2">Boot kaufen (1000) - Aktuell: 0</button><br><br>
    <button id="buyUpgrade3">Kundenrabatt (5000) - Aktuell: 0</button>
  </div>
</div>
 
<button id="showBtn">🐟</button>
 
<script type="module" src="/js/clicker.js"></script>
</div>
</div>
</body>
</html>
